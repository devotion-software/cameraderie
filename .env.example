# ─────────────────────────────────────────────────────────────
# Cameraderie environment. Copy to .env and fill in real values.
# Never commit .env. Secrets live here on the host, never in clients.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# Public base URL of the API (used by Better Auth for callback/cookie config)
API_URL=http://localhost:3000
# Public base URL of the web client (CORS origin, trusted origin for auth)
WEB_URL=http://localhost:5173
API_PORT=3000

# --- Database (MariaDB / MySQL-compatible) ---
# Used by the api + worker. In docker-compose the host is "mariadb".
DATABASE_URL=mysql://cameraderie:cameraderie@localhost:3306/cameraderie
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=cameraderie
MARIADB_USER=cameraderie
MARIADB_PASSWORD=cameraderie

# --- Auth (Better Auth) ---
# 32+ char random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# --- Redis (BullMQ) ---
# In docker-compose the host is "redis".
REDIS_URL=redis://localhost:6379
# REQUIRED in production (docker-compose.prod.yml): Redis is password-protected
# and the app connects as redis://:$REDIS_PASSWORD@redis:6379. Generate:
# openssl rand -base64 32. Leave blank for local dev (no auth).
REDIS_PASSWORD=

# --- Cloudflare R2 (S3-compatible) ---
# From the R2 dashboard: create a bucket + an API token (Access Key / Secret).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=cameraderie
# Endpoint is derived from the account id but can be overridden:
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Seconds a presigned URL stays valid (keep short).
R2_PRESIGN_TTL_SECONDS=900

# --- Local S3 for development (Garage) ---
# Run `docker compose up garage garage-init` to get a local, R2-compatible
# store. Then uncomment the four lines below to point the app at it instead
# of real R2 — no code change needed. (We use Garage, not MinIO — MinIO's
# Docker images now require a login to even pull.)
# R2_ENDPOINT must be what the BROWSER reaches, because presigned URLs are
# signed against this exact host and the browser uploads straight to it.
# This works as-is when you run the api/worker on the host (bun --watch).
# If you run the WHOLE stack in containers against Garage, the api container
# can't reach "localhost:3900" — add `127.0.0.1 garage` to your /etc/hosts
# and set R2_ENDPOINT=http://garage:3900 so one host resolves on both sides.
# R2_ACCOUNT_ID=local
# R2_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
# R2_SECRET_ACCESS_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# R2_ENDPOINT=http://localhost:3900
# Credentials for the local Garage container (match R2_* above). Garage
# requires this exact format dev-only placeholders: access key ID is "GK" +
# 24 hex chars, secret key is 64 hex chars.
GARAGE_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
GARAGE_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# --- Quotas ---
# Free tier size in bytes (5 GB). Paid tiers are configured in shared/plans.
FREE_TIER_BYTES=5368709120

# --- Billing (optional; billing is disabled until these are set) ---
# Stripe (web). From the Stripe dashboard: secret key, webhook signing secret,
# and a recurring Price id per paid plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# RevenueCat (mobile). The shared Authorization header value you set on the
# RevenueCat webhook ("Bearer <this>").
REVENUECAT_WEBHOOK_SECRET=

# --- Observability (optional) ---
# Sentry DSN for the API and worker. Leave blank to disable.
SENTRY_DSN=

# --- Content safety (worker) ---
# Comma-separated SHA-256 hex digests to block on upload. A real deployment
# would call a hash-matching service instead of this static list. A match
# quarantines (preserves) the upload and fires a Sentry alert rather than
# deleting it.
BLOCKED_SHA256=

# --- Sign-up allowlist (API) ---
# Comma-separated emails permitted to create an account. When set, every other
# sign-up is rejected (this keeps the app invite-only). Leave blank for OPEN
# sign-up (dev only — a warning is logged); set it before sharing the app.
ALLOWED_SIGNUP_EMAILS=

# --- Worker ---
# Max concurrent derivative jobs (keep low on a small VPS).
WORKER_CONCURRENCY=2
# Path to ffmpeg / ffprobe / dcraw_emu if not on PATH (optional).
FFMPEG_PATH=
FFPROBE_PATH=
DCRAW_EMU_PATH=
# Hard timeouts (seconds) for untrusted-media tools — a hung/adversarial file is
# killed rather than pinning a worker slot. ffmpeg also gets a CPU -timelimit and
# a thread cap.
FFMPEG_TIMEOUT_SECONDS=300
FFPROBE_TIMEOUT_SECONDS=30
DCRAW_TIMEOUT_SECONDS=180
FFMPEG_THREADS=2
# Container resource caps for the worker (docker-compose.prod.yml). Size to your VPS.
WORKER_MEM_LIMIT=3g
WORKER_CPUS=2

# --- Production reverse proxy (docker-compose.prod.yml) ---
# Domains Caddy serves with automatic HTTPS. In production also set API_URL and
# WEB_URL above to the https:// versions of these.
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com

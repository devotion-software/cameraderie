<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-only network security config: allows plaintext HTTP to localhost / the
  Android emulator loopback alias so you can point AppConfig.API_BASE_URL at
  a local backend without TLS. Tighten or remove this before shipping.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
